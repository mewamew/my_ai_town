+func _write_fixture_extras(
+	store: RefCounted,
+	slot_id: String,
+	session_id: String,
+) -> Dictionary:
+	var startup: RefCounted = STARTUP_CATALOG.new()
+	var configured_startup := startup.call("configure", store) as Dictionary
+	if not bool(configured_startup.get("ok", false)):
+		return configured_startup
+	var profile := startup.call(
+		"record_last_played",
+		slot_id,
+		[slot_id],
+	) as Dictionary
+	if not bool(profile.get("ok", false)):
+		return profile
+
+	var library: RefCounted = CUSTOM_RESIDENT_LIBRARY.new()
+	var configured_library := library.call("configure") as Dictionary
+	if not bool(configured_library.get("ok", false)):
+		return configured_library
+	var library_written := library.call(
+		"replace_candidates",
+		[
+			{
+				"residentId": "fixture-custom-resident",
+				"residentName": "历史样本居民",
+				"source": "custom",
+			},
+		],
+		1,
+		2,
+	) as Dictionary
+	if not bool(library_written.get("ok", false)):
+		return library_written
+
+	var photos: RefCounted = PHOTO_STORE.new()
+	var configured_photos := photos.call(
+		"configure_session",
+		slot_id,
+		session_id,
+	) as Dictionary
+	if not bool(configured_photos.get("ok", false)):
+		return configured_photos
+	var owner_id := "historical-fixture-photo"
+	var staged := photos.call(
+		"stage_file",
+		"res://assets/ui/town/hud/runtime/action_icons_readable_v4/markers/result_completed.png",
+		owner_id,
+	) as Dictionary
+	if not bool(staged.get("ok", false)):
+		return staged
+	var photo_ref := String(staged.get("ref", ""))
+	var mime_type := String(staged.get("mimeType", ""))
+	if not bool(photos.call("commit_photo", photo_ref, mime_type, owner_id)):
+		return {"ok": false, "errorCode": "FIXTURE_PHOTO_COMMIT_FAILED"}
+	return {
+		"ok": true,
+		"errorCode": "",
+		"photoRef": photo_ref,
+	}
